# Firebase & Supabase Configuration Template

## Copy this file to `.env.local` and fill in your credentials

# ============================================================
# Storage Provider Choice (firebase or supabase)
# ============================================================
REACT_APP_STORAGE_PROVIDER=firebase

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
# Get these from Firebase Console > Project Settings
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_ID=
REACT_APP_FIREBASE_APP_ID=

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# Get these from Supabase Dashboard > Project Settings > API
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# ============================================================
# GOOGLE ADMOB (Optional - for native builds)
# ============================================================
# These are already in App.jsx, but you can override here if needed
REACT_APP_ADMOB_APP_ID=ca-app-pub-1268492465575554~2328637637
REACT_APP_ADMOB_BANNER=ca-app-pub-1268492465575554/1015555967
REACT_APP_ADMOB_INTERSTITIAL=ca-app-pub-1268492465575554/1864090437
REACT_APP_ADMOB_REWARDED=ca-app-pub-1268492465575554/5317868254
